# systemd unit for wiser-dashboard. Install:
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin wiser-dashboard
#   sudo install -m 755 wiser-dashboard /usr/local/bin/
#   sudo install -m 640 -g wiser-dashboard ~/wiser_secret.txt /etc/wiser-dashboard.secret
#   sudo install -m 644 wiser-dashboard.service /etc/systemd/system/
#   sudo systemctl enable --now wiser-dashboard
#
# Config, history and health logs live in /var/lib/wiser-dashboard. Only root
# and the service can read the secret. Optional settings
# (e.g. WISER_DASHBOARD_PASSWORD=...) go in /etc/wiser-dashboard.env.

[Unit]
Description=Wiser heating dashboard and Home Assistant proxy
Documentation=https://github.com/shenhab/wiser-dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wiser-dashboard -listen :8080 -config ${STATE_DIRECTORY}/config.json -secret-file /etc/wiser-dashboard.secret
EnvironmentFile=-/etc/wiser-dashboard.env
Restart=always
RestartSec=5

User=wiser-dashboard
Group=wiser-dashboard
StateDirectory=wiser-dashboard
StateDirectoryMode=0700
UMask=0077

# Hardening: it only needs the network and its state directory.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK lets it list this machine's addresses (hub discovery, LAN URL).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
